# Review prompt + feedback form (docs/designGuidelines.md section 5). Copy to .env.
# Feature flag: the prompt only runs when this is exactly "true". Off for the first release.
WXT_REVIEW_PROMPT_ENABLED=false
# Leave the store id empty until the extension is published (a temporary fallback is used).
WXT_STORE_EXTENSION_ID=
# Published form: https://docs.google.com/forms/d/e/<WXT_FEEDBACK_FORM_ID>/viewform
WXT_FEEDBACK_FORM_ID=1FAIpQLSdvknhi5MTc7qq7tR9XIawN5-mMasOxze4w2GRxEPSgeeJdBg
WXT_FEEDBACK_FORM_ENTRY_EXTENSION=entry.776165306
WXT_FEEDBACK_FORM_ENTRY_NAME=entry.1884265043
WXT_FEEDBACK_FORM_ENTRY_EMAIL=entry.880462966
WXT_FEEDBACK_FORM_ENTRY_MESSAGE=entry.768003692
